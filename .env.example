# =========================================================================
# Village LabPulse - Environment Variables Template
# =========================================================================

# 1. Supabase Cloud Database (Get from https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Central Express Backend (Optional if using direct Supabase cloud sync)
VITE_CENTRAL_SERVER_URL=http://localhost:5000
